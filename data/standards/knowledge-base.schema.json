{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Base corpus",
  "type": "object",
  "required": [
    "schema_version",
    "record_count",
    "domains",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "record_count": {
      "type": "integer"
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

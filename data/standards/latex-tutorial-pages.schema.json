{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LaTeX tutorial pages",
  "type": "object",
  "required": [
    "schema_version",
    "source_file",
    "page_count",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
    "page_count": {
      "type": "integer"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "page",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "content": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
